# zsh-claude-complete
#
# Natural-language shell commands, generated by Claude.
#
#   Type:  AI <describe what you want> <TAB>
#   Result: the buffer is replaced with the generated command.
#   Pressing Enter instead of TAB also works: the generated command is
#   placed on the next prompt line for editing.
#
# Backends (ZSH_AI_BACKEND):
#   api  - Anthropic Messages API via curl. Needs curl, jq, and either
#          ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN (OAuth bearer token).
#   cli  - Claude Code headless mode (`claude -p`). Uses your existing login.
#   Default: "api" when ANTHROPIC_API_KEY is set, otherwise "cli".
#
# Options (all environment variables, set before sourcing or any time after):
#   ZSH_AI_PREFIX    Trigger word at the start of the buffer. Default: "AI"
#   ZSH_AI_MODEL     Model id. Default: claude-opus-5
#   ZSH_AI_EFFORT    Anthropic effort level for the api backend. Default: low
#   ZSH_AI_MAX_TOKENS  Output cap for the api backend. Default: 512
#   ZSH_AI_KEY       Key to bind. Default: '^I' (TAB). Set to "" to skip binding.
#   ZSH_AI_DEBUG     When set, the last raw response is written to
#                    $ZSH_AI_DEBUG (a file path).

: ${ZSH_AI_PREFIX:=AI}
: ${ZSH_AI_MODEL:=claude-opus-5}
: ${ZSH_AI_EFFORT:=low}
: ${ZSH_AI_MAX_TOKENS:=512}
: ${ZSH_AI_KEY:=^I}

_zsh_ai_system_prompt() {
  local os shell_ver
  os="$(uname -s 2>/dev/null) $(uname -r 2>/dev/null)"
  shell_ver="zsh ${ZSH_VERSION}"
  print -r -- "You translate a plain-English request into a shell command for the user's terminal.
Environment: ${os}, ${shell_ver}, working directory ${PWD}.
Rules:
- Reply with the command only. No explanation, no comments, no markdown, no code fences.
- Prefer one line. If several commands are needed, join them with && or ; on one line.
- Prefer widely available POSIX and GNU/BSD tools appropriate for the environment above.
- Never invent flags. If the request is ambiguous, pick the most common interpretation.
- Do not run anything; only print the command."
}

_zsh_ai_backend() {
  if [[ -n "$ZSH_AI_BACKEND" ]]; then
    print -r -- "$ZSH_AI_BACKEND"
  elif [[ -n "$ANTHROPIC_API_KEY" || -n "$ANTHROPIC_AUTH_TOKEN" ]]; then
    print -r -- api
  else
    print -r -- cli
  fi
}

# Anthropic Messages API via curl. The body is built with jq so the prompt is
# always valid JSON regardless of quotes or newlines.
_zsh_ai_generate_api() {
  local prompt="$1" system="$2" body response

  (( $+commands[curl] )) || { print "zsh-claude-complete: curl not found" >&2; return 1; }
  (( $+commands[jq] ))   || { print "zsh-claude-complete: jq not found" >&2; return 1; }
  local -a auth
  if [[ -n "$ANTHROPIC_API_KEY" ]]; then
    auth=(-H "x-api-key: $ANTHROPIC_API_KEY")
  elif [[ -n "$ANTHROPIC_AUTH_TOKEN" ]]; then
    auth=(-H "Authorization: Bearer $ANTHROPIC_AUTH_TOKEN" -H "anthropic-beta: oauth-2025-04-20")
  else
    print "zsh-claude-complete: ANTHROPIC_API_KEY (or ANTHROPIC_AUTH_TOKEN) not set" >&2
    return 1
  fi

  body=$(jq -n \
    --arg model "$ZSH_AI_MODEL" \
    --arg effort "$ZSH_AI_EFFORT" \
    --argjson max_tokens "$ZSH_AI_MAX_TOKENS" \
    --arg system "$system" \
    --arg prompt "$prompt" \
    '{
      model: $model,
      max_tokens: $max_tokens,
      output_config: { effort: $effort },
      system: $system,
      messages: [ { role: "user", content: $prompt } ]
    }') || return 1

  response=$(curl -sS --max-time 60 https://api.anthropic.com/v1/messages \
    "${auth[@]}" \
    -H "anthropic-version: 2023-06-01" \
    -H "content-type: application/json" \
    -d "$body") || { print "zsh-claude-complete: request failed" >&2; return 1; }

  [[ -n "$ZSH_AI_DEBUG" ]] && print -r -- "$response" > "$ZSH_AI_DEBUG"

  local err
  err=$(print -r -- "$response" | jq -r '.error.message // empty' 2>/dev/null)
  if [[ -n "$err" ]]; then
    print "zsh-claude-complete: $err" >&2
    return 1
  fi

  local stop
  stop=$(print -r -- "$response" | jq -r '.stop_reason // empty' 2>/dev/null)
  if [[ "$stop" == refusal ]]; then
    print "zsh-claude-complete: request was declined" >&2
    return 1
  fi

  print -r -- "$response" | jq -r '[.content[] | select(.type == "text") | .text] | join("")'
}

# Claude Code headless mode. No tools, no session file, model from ZSH_AI_MODEL.
_zsh_ai_generate_cli() {
  local prompt="$1" system="$2" out

  (( $+commands[claude] )) || { print "zsh-claude-complete: claude CLI not found" >&2; return 1; }

  out=$(command claude -p "$prompt" \
    --system-prompt "$system" \
    --model "$ZSH_AI_MODEL" \
    --tools "" \
    --no-session-persistence 2>/dev/null) || { print "zsh-claude-complete: claude -p failed" >&2; return 1; }

  [[ -n "$ZSH_AI_DEBUG" ]] && print -r -- "$out" > "$ZSH_AI_DEBUG"
  print -r -- "$out"
}

# Public: print the generated command for a prompt. Usable outside zle, e.g.
#   zsh_ai_generate "find large files in this directory"
zsh_ai_generate() {
  local prompt="$*" system raw cmd backend
  [[ -n "$prompt" ]] || { print "zsh-claude-complete: empty prompt" >&2; return 1; }

  system="$(_zsh_ai_system_prompt)"
  backend="$(_zsh_ai_backend)"

  case "$backend" in
    api) raw=$(_zsh_ai_generate_api "$prompt" "$system") || return 1 ;;
    cli) raw=$(_zsh_ai_generate_cli "$prompt" "$system") || return 1 ;;
    *)   print "zsh-claude-complete: unknown backend '$backend'" >&2; return 1 ;;
  esac

  # Strip code fences and blank lines, then join remaining lines with "; ".
  cmd=$(print -r -- "$raw" | sed -e '/^[[:space:]]*```/d' | awk 'NF' | paste -sd ';' - | sed -e 's/;/; /g')
  cmd="${cmd##[[:space:]]}"
  cmd="${cmd%%[[:space:]]}"

  [[ -n "$cmd" ]] || { print "zsh-claude-complete: no command generated" >&2; return 1; }
  print -r -- "$cmd"
}

_zsh_ai_widget() {
  if [[ $BUFFER == "${ZSH_AI_PREFIX} "* ]]; then
    local prompt="${BUFFER#${ZSH_AI_PREFIX} }"
    local cmd err errfile
    errfile=$(mktemp -t zsh-ai-complete.XXXXXX)
    zle -M "Asking Claude..."
    cmd=$(zsh_ai_generate "$prompt" 2>"$errfile")
    err=$(<"$errfile")
    rm -f "$errfile"
    if [[ -n "$cmd" ]]; then
      BUFFER="$cmd"
      CURSOR=${#BUFFER}
      zle -M ""
    else
      zle -M "${err:-zsh-claude-complete: no command generated}"
    fi
  else
    zle expand-or-complete
  fi
}

# Enter fallback: running "AI <request>" as a command generates the command and
# pushes it onto the next prompt line with print -z, so it can be edited before
# it runs. The function is named after ZSH_AI_PREFIX at source time.
_zsh_ai_command() {
  local cmd
  cmd=$(zsh_ai_generate "$@") || return 1
  print -z -- "$cmd"
}
functions[$ZSH_AI_PREFIX]=$functions[_zsh_ai_command]

zle -N _zsh_ai_widget
if [[ -n "$ZSH_AI_KEY" ]]; then
  bindkey "$ZSH_AI_KEY" _zsh_ai_widget
fi
